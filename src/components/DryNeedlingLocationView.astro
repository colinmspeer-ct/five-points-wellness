---
import { absUrl, href } from "../lib/legacy";
import Base from "../layouts/Base.astro";
import PageHero from "./PageHero.astro";
import CtaBand from "./CtaBand.astro";
import DryNeedlingLinks from "./DryNeedlingLinks.astro";
import FaqList from "./FaqList.astro";
import Hours from "./Hours.astro";
import { dryNeedlingPlaces } from "../data/dryNeedlingPlaces";
import { locations } from "../data/locations";
import { addressLine, practice } from "../data/site";

interface Props { slug: string }
const { slug } = Astro.props;
const page = dryNeedlingPlaces.find((item) => item.slug === slug);
if (!page) throw new Error(`Missing dry needling place ${slug}`);
const acupunctureSlug = page.slug.replace("dry-needling-", "acupuncture-");
const area = locations.find((item) => item.slug === acupunctureSlug);

const url = absUrl(`/${page.slug}`);
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Dry needling", href: "/acupuncture/dry-needling" },
  { name: page.name, href: `/${page.slug}` },
];
const extraGraph = [
  {
    "@type": "Service",
    name: `Dry needling in ${page.name}`,
    serviceType: "Dry needling",
    url,
    provider: { "@id": `${practice.url}/#practice` },
    areaServed: { "@type": "Place", name: `${page.name}, Philadelphia, PA` },
    description:
      "Orthopedic dry needling for trigger points, motor points, muscular pain, and movement restrictions at Five Points Wellness LLC in Fishtown.",
  },
  {
    "@type": "FAQPage",
    mainEntity: page.faqs.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];
---

<Base title={page.title} description={page.description} crumbs={crumbs} extraGraph={extraGraph}>
  <PageHero eyebrow={`Dry Needling · ${practice.street}`} lede={page.lede}>{page.h1}</PageHero>
  <section class="band">
    <article class="narrow prose">
      {area && (
        <dl class="facts card" style="padding:1.25rem 1.5rem">
          <div><dt>Distance</dt><dd>{area.distance}</dd></div>
          <div><dt>ZIP codes</dt><dd>{area.zips} · studio 19125</dd></div>
        </dl>
      )}
      <h2>Getting Here from {page.name}</h2>
      {page.trip.map((paragraph) => <p>{paragraph}</p>)}
      {area && (
        <>
          <h2>Landmarks in {page.name}</h2>
          <ul class="checklist cols">
            {area.landmarks.map((item) => <li>{item}</li>)}
          </ul>
        </>
      )}
      <h2>About Dry Needling</h2>
      <p>
        Dry needling is a technique used to treat muscular pain, trigger points, and movement dysfunction using fine, sterile needles. At Five Points Wellness, it is performed within the broader framework of acupuncture and integrative musculoskeletal care.
      </p>
      <p>Dry needling is commonly used for:</p>
      <ul class="checklist cols">
        <li>Neck and shoulder pain</li>
        <li>Back pain and postural tension</li>
        <li>Sciatica and nerve-related pain patterns</li>
        <li>Hip, knee, and joint dysfunction</li>
        <li>Sports injuries and overuse conditions</li>
        <li>Muscle tightness and chronic tension</li>
        <li>Headaches and TMJ-related pain</li>
        <li>Restricted mobility or movement imbalance</li>
      </ul>
      <p>
        Read more on the main <a href={href("/acupuncture/dry-needling")}>orthopedic dry needling</a> page, including the before and after range-of-motion photos. For acupuncture from the same area, see <a href={href(`/${acupunctureSlug}`)}>acupuncture in {page.name}</a>.
      </p>
      <h2>Hours</h2>
      <div class="card" style="padding:1.25rem 1.5rem;max-width:26rem"><Hours compact /></div>
      <FaqList items={page.faqs} heading={`Questions about dry needling in ${page.name}`} />
      <CtaBand heading="Book a Session" text={`We're at ${addressLine}. Call or text ${practice.phoneDisplay}, or book online.`} />
      <p class="subhead">Dry Needling in Other Neighborhoods</p>
      <DryNeedlingLinks except={page.slug} />
    </article>
  </section>
</Base>
