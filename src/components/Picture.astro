---
interface Props {
  name: string;
  width: number;
  height: number;
  alt: string;
  class?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
}
const { name, width, height, alt, class: className, loading = "lazy", fetchpriority } = Astro.props;
const avif = `/images/${name}.avif`;
const webp = `/images/${name}.webp`;
---
<picture>
  <source srcset={avif} type="image/avif" />
  <source srcset={webp} type="image/webp" />
  <img
    src={webp}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    class={className}
  />
</picture>
