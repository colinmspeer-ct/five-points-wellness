---
import Base from "../layouts/Base.astro";
import PageHero from "./PageHero.astro";
import CtaBand from "./CtaBand.astro";
import FaqList from "./FaqList.astro";
import ServiceLinks from "./ServiceLinks.astro";
import { modalities } from "../data/modalities";
import { modalityCopy } from "../data/modalityCopy";
import { addressLine, practice } from "../data/site";

interface Props { slug: string }
const { slug } = Astro.props;
const page = modalities.find((item) => item.slug === slug);
if (!page) throw new Error(`Missing modality ${slug}`);
const copy = modalityCopy[slug] ?? { lede: page.lede, sections: page.sections };

const url = `${practice.url}/${page.slug}`;
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Services", href: "/services" },
  { name: page.name, href: `/${page.slug}` },
];
const extraGraph = [
  {
    "@type": "Service",
    name: page.name,
    serviceType: page.serviceType,
    url,
    provider: { "@id": `${practice.url}/#practice` },
    areaServed: { "@type": "City", name: "Philadelphia" },
    description: page.description,
  },
  {
    "@type": "FAQPage",
    mainEntity: page.faqs.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];
---

<Base title={page.title} description={page.description} crumbs={crumbs} extraGraph={extraGraph}>
  <PageHero eyebrow="Our Services" lede={copy.lede}>{page.h1}</PageHero>
  <section class="band">
    <article class="narrow prose">
      {copy.sections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </section>
      ))}
      <FaqList items={page.faqs} />
      <CtaBand />
      <p class="subhead">Where to Find Us</p>
      <p>
        {page.name} is offered at <strong>{practice.name}</strong>, {addressLine}, with {practice.practitionerFull}. See <a href="/acupuncture-fishtown">acupuncture in Fishtown</a> for parking, the El stop, and hours, or start from your own neighborhood on the <a href="/locations">locations</a> page.
      </p>
      <p class="subhead">Other Services</p>
      <ServiceLinks except={`/${page.slug}`} />
    </article>
  </section>
</Base>
