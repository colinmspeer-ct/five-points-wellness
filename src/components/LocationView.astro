---
import { absUrl, href } from "../lib/legacy";
import Base from "../layouts/Base.astro";
import PageHero from "./PageHero.astro";
import CtaBand from "./CtaBand.astro";
import FaqList from "./FaqList.astro";
import Hours from "./Hours.astro";
import LocationLinks from "./LocationLinks.astro";
import ServiceLinks from "./ServiceLinks.astro";
import { conditionMeta, conditionOrder } from "../data/conditionMeta";
import { areas } from "../data/areas";
import { locations } from "../data/locations";
import { addressLine, practice } from "../data/site";

interface Props { slug: string }
const { slug } = Astro.props;
const page = locations.find((item) => item.slug === slug);
if (!page) throw new Error(`Missing location ${slug}`);

const nearSlug = page.slug.slice("acupuncture-".length);
// Area hubs replaced the old /dry-needling-<area> pages; only places without a hub keep that form.
const dryNeedlingHref = areas.some((item) => item.slug === nearSlug) ? `/${nearSlug}/dry-needling` : `/dry-needling-${nearSlug}`;
const url = absUrl(`/${page.slug}`);
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Locations", href: "/locations" },
  { name: page.name, href: `/${page.slug}` },
];
const extraGraph = [
  {
    "@type": "Service",
    name: `Acupuncture in ${page.name}`,
    serviceType: "Acupuncture",
    url,
    provider: { "@id": `${practice.url}/#practice` },
    areaServed: { "@type": "Place", name: `${page.name}, Philadelphia, PA` },
  },
  {
    "@type": "FAQPage",
    mainEntity: page.faqs.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];
---

<Base title={page.title} description={page.description} crumbs={crumbs} extraGraph={extraGraph}>
  <PageHero eyebrow={`Five Points Wellness · ${practice.street}`} lede={page.lede}>{page.h1}</PageHero>
  <section class="band">
    <article class="narrow prose">
      <dl class="facts card" style="padding:1.25rem 1.5rem">
        <div><dt>Distance</dt><dd>{page.distance}</dd></div>
        <div><dt>ZIP codes</dt><dd>{page.zips} · studio 19125</dd></div>
      </dl>
      {page.sections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </section>
      ))}
      <h2>Landmarks in {page.name}</h2>
      <ul class="checklist cols">
        {page.landmarks.map((item) => <li>{item}</li>)}
      </ul>
      <h2>Hours</h2>
      <div class="card" style="padding:1.25rem 1.5rem;max-width:26rem"><Hours compact /></div>
      <h2>Dry Needling from {page.name}</h2>
      <p>
        Orthopedic dry needling is offered at the same studio. See <a href={href(dryNeedlingHref)}>dry needling in {page.name}</a>, or the main <a href={href("/acupuncture/dry-needling")}>orthopedic dry needling</a> page.
      </p>
      <FaqList items={page.faqs} heading={`Questions about acupuncture in ${page.name}`} />
      <CtaBand text={`We're at ${addressLine}. Call or text ${practice.phoneDisplay}, or book online.`} />
      <p class="subhead">Our Services</p>
      <ServiceLinks />
      <p class="subhead">Conditions We Treat</p>
      <ul class="chips">
        {conditionOrder.map((item) => (
          <li><a href={href(`/acupuncture/${item}`)}>{conditionMeta[item].label}</a></li>
        ))}
      </ul>
      <LocationLinks except={page.slug} />
    </article>
  </section>
</Base>
