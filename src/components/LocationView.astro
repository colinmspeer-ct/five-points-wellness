---
import Base from "../layouts/Base.astro";
import Actions from "./Actions.astro";
import CtaBand from "./CtaBand.astro";
import FaqList from "./FaqList.astro";
import Hours from "./Hours.astro";
import LocationLinks from "./LocationLinks.astro";
import ServiceLinks from "./ServiceLinks.astro";
import { locations } from "../data/locations";
import { addressLine, practice } from "../data/site";

interface Props { slug: string }
const { slug } = Astro.props;
const page = locations.find((item) => item.slug === slug);
if (!page) throw new Error(`Missing location ${slug}`);

const url = `${practice.url}/${page.slug}`;
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Locations", href: "/locations" },
  { name: page.name, href: `/${page.slug}` },
];
const extraGraph = [
  {
    "@type": "Service",
    name: `Acupuncture in ${page.name}`,
    serviceType: "Acupuncture",
    url,
    provider: { "@id": `${practice.url}/#practice` },
    areaServed: { "@type": "Place", name: `${page.name}, Philadelphia, PA` },
  },
  {
    "@type": "FAQPage",
    mainEntity: page.faqs.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];
---

<Base title={page.title} description={page.description} crumbs={crumbs} extraGraph={extraGraph}>
  <article class="wrap content">
    <header class="page-hero">
      <p class="eyebrow">Five Points Wellness LLC · {addressLine}</p>
      <h1>{page.h1}</h1>
      <p class="lede">{page.lede}</p>
      <Actions />
    </header>
    <p><strong>{page.distance}</strong> ZIP codes patients use for this trip: <strong>{page.zips}</strong>. The office ZIP code is <strong>19125</strong>.</p>
    {page.sections.map((section) => (
      <section>
        <h2>{section.heading}</h2>
        {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </section>
    ))}
    <h2>Landmarks people name in {page.name}</h2>
    <ul class="checklist">
      {page.landmarks.map((item) => <li>{item}</li>)}
    </ul>
    <h2>Hours at the Fishtown office</h2>
    <Hours />
    <h2>Acupuncture and related care for {page.name}</h2>
    <p>
      Every service below is offered from the same office. Anchor text matches the service so you can open the page that fits the question you actually have.
    </p>
    <ServiceLinks />
    <h3>Condition pages</h3>
    <ul class="checklist">
      <li><a href="/acupuncture/pain-injury-recovery">acupuncture for pain and injury</a></li>
      <li><a href="/acupuncture/stress-sleep-wellness">acupuncture for stress and sleep</a></li>
      <li><a href="/acupuncture/womens-health-fertility">women's health and fertility acupuncture</a></li>
      <li><a href="/acupuncture/digestive-support">acupuncture for digestion</a></li>
      <li><a href="/acupuncture/immune-autoimmune">immune and autoimmune support</a></li>
      <li><a href="/acupuncture/neurological-health">neurological acupuncture</a></li>
      <li><a href="/acupuncture/sports-performance-recovery">sports acupuncture and recovery</a></li>
      <li><a href="/acupuncture/facial-rejuvenation-cosmetic">cosmetic acupuncture</a></li>
      <li><a href="/acupuncture/surgical-recovery-scar-treatment">surgical recovery and scar acupuncture</a></li>
    </ul>
    <h2>Acupuncture in other Philadelphia neighborhoods</h2>
    <LocationLinks except={page.slug} />
    <FaqList items={page.faqs} heading={`Questions about acupuncture in ${page.name}`} />
    <CtaBand heading={`Book from ${page.name}`} text={`The office is ${addressLine}. Call or text ${practice.phoneDisplay}, or use the patient portal.`} />
  </article>
</Base>
