---
import { href } from "../lib/legacy";
import Picture from "./Picture.astro";
import { conditionMeta, conditionOrder } from "../data/conditionMeta";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const current = (href: string) => (path === href ? "page" : undefined);
const inAcupuncture =
  path.startsWith("/acupuncture") || path.startsWith("/acupuncture/dry-needling") || path === "/locations";
const logoAlt =
  "Five Points Wellness logo: a circular yin-yang drawn as a fine black and white grid, with a ring of small marks around the edge. Choose it to return to the Fishtown acupuncture homepage.";
---

<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="bar">
    <a class="brand" href={href("/")} aria-current={current("/")}>
      <Picture
        name="five-points-wellness-logo"
        width={76}
        height={76}
        alt={logoAlt}
        loading="eager"
        class="logo"
      />
      <span>Five Points Wellness</span>
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <a href={href("/about")} aria-current={current("/about")}>About</a>
      <a href={href("/services")} aria-current={current("/services")}>Services</a>
      <details class:list={["menu", { "is-current": inAcupuncture }]} data-hover-menu>
        <summary>
          Acupuncture
          <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="menu-panel">
          <a href={href("/acupuncture")} aria-current={current("/acupuncture")}>Acupuncture in Philadelphia</a>
          <hr />
          {conditionOrder.map((slug) => (
            <a href={href(`/acupuncture/${slug}`)} aria-current={current(`/acupuncture/${slug}`)}>{conditionMeta[slug].label}</a>
          ))}
          <a href={href("/acupuncture/dry-needling")} aria-current={current("/acupuncture/dry-needling")}>Dry Needling</a>
          <hr />
          <a href={href("/locations")} aria-current={current("/locations")}>Neighborhoods we serve</a>
        </div>
      </details>
      <a href={href("/microneedling")} aria-current={current("/microneedling")}>Microneedling</a>
      <a href={href("/contact")} aria-current={current("/contact")}>Contact</a>
      <a class="btn btn-primary" href={href("/book-appointment")}>Book Appointment</a>
    </nav>

    <details class="burger mobile-nav">
      <summary aria-label="Menu">
        <svg class="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </summary>
      <nav class="sheet" aria-label="Mobile">
        <a href={href("/about")}>About</a>
        <a href={href("/services")}>Services</a>
        <details>
          <summary>
            Acupuncture
            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <div class="sub">
            <a href={href("/acupuncture")}>Acupuncture in Philadelphia</a>
            {conditionOrder.map((slug) => (
              <a href={href(`/acupuncture/${slug}`)}>{conditionMeta[slug].label}</a>
            ))}
            <a href={href("/acupuncture/dry-needling")}>Dry Needling</a>
            <a href={href("/locations")}>Neighborhoods we serve</a>
          </div>
        </details>
        <a href={href("/microneedling")}>Microneedling</a>
        <a href={href("/contact")}>Contact</a>
        <a class="btn btn-primary btn-lg" href={href("/book-appointment")}>Book Appointment</a>
        <p class="sheet-contact">Call or text <a href="tel:+16107425810">(610) 742-5810</a></p>
      </nav>
    </details>
  </div>
</header>

<script is:inline>
  (function () {
    var menus = document.querySelectorAll("[data-hover-menu]");
    var fine = window.matchMedia("(hover: hover) and (pointer: fine)");
    menus.forEach(function (menu) {
      var timer;
      menu.addEventListener("mouseenter", function () {
        if (!fine.matches) return;
        clearTimeout(timer);
        menu.open = true;
      });
      menu.addEventListener("mouseleave", function () {
        if (!fine.matches) return;
        timer = setTimeout(function () { menu.open = false; }, 160);
      });
    });
    document.addEventListener("click", function (event) {
      document.querySelectorAll(".menu[open], .burger[open]").forEach(function (open) {
        if (!open.contains(event.target)) open.open = false;
      });
    });
    document.addEventListener("keydown", function (event) {
      if (event.key !== "Escape") return;
      document.querySelectorAll(".menu[open], .burger[open]").forEach(function (open) {
        open.open = false;
        var summary = open.querySelector("summary");
        if (summary) summary.focus();
      });
    });
  })();
</script>
