---
import YinYangIcon from "./YinYangIcon.astro";
interface Props { heading?: string; text?: string }
const {
  heading = "Ready to get started?",
  text = "Book your appointment online and begin your care. If you have questions first, you're also welcome to schedule a complimentary session before committing.",
} = Astro.props;
---
<section class="card cta-card">
  <YinYangIcon />
  <h2>{heading}</h2>
  <p>{text}</p>
  <div class="actions">
    <a class="btn btn-primary" href="/book-appointment">Book an Appointment</a>
    <a class="btn btn-outline" href="/book-appointment#portal">Schedule a Complimentary Consultation</a>
  </div>
  <p class="actions-note">Or call or text <a href="tel:+16107425810">(610) 742-5810</a>.</p>
</section>
