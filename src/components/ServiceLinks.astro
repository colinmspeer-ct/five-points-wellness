---
const links = [
  { href: "/acupuncture", text: "Acupuncture" },
  { href: "/dry-needling", text: "Orthopedic Dry Needling" },
  { href: "/moxibustion", text: "Moxibustion" },
  { href: "/gua-sha", text: "Gua Sha" },
  { href: "/cupping", text: "Cupping" },
  { href: "/facial-cupping", text: "Facial Cupping" },
  { href: "/herbal-liniments", text: "Herbal Liniments" },
  { href: "/tuina", text: "Tuina" },
  { href: "/nutrition", text: "Nutrition" },
  { href: "/qigong", text: "Qigong" },
  { href: "/microneedling", text: "Microneedling" },
  { href: "/acupuncture/pediatric-acupuncture", text: "Pediatric Acupuncture" },
];
interface Props { except?: string; center?: boolean }
const { except, center = false } = Astro.props;
---
<ul class:list={["chips", { center }]}>
  {links.filter((link) => link.href !== except).map((link) => (
    <li><a href={link.href}>{link.text}</a></li>
  ))}
</ul>
