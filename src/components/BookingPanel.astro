---
import YinYangIcon from "./YinYangIcon.astro";
import { practice } from "../data/site";
interface Props { id?: string; heading?: string; lead?: string; small?: string; frameTitle?: string }
const {
  id = "portal",
  heading = "Book an Appointment",
  lead = "Schedule your appointment online using our patient portal.",
  small = "Have questions before committing? You can also use the portal to schedule a complimentary session to talk through what you're dealing with and whether acupuncture is a good fit.",
  frameTitle = "Book Consultation or Appointment",
} = Astro.props;
---
<section class="card book-panel" id={id}>
  <YinYangIcon size={40} />
  <h2>{heading}</h2>
  <p class="lead">{lead}</p>
  <p class="small">{small}</p>
  <div class="booking-frame">
    <iframe src={practice.bookingUrl} title={frameTitle} loading="lazy"></iframe>
  </div>
  <p class="portal-fallback">Calendar not showing? <a href={practice.bookingUrl}>Open the patient portal</a></p>
</section>
