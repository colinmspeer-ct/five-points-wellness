---
/* Faint rotating yin-yang, as on the original site. Purely decorative. */
interface Props { size: number; class?: string; style?: string; slow?: boolean }
const { size, class: className, style, slow = false } = Astro.props;
---
<div class:list={["yy-float", className]} style={`width:${size}px;height:${size}px;${style ?? ""}`} aria-hidden="true">
  <picture>
    <source srcset="/images/five-points-wellness-logo.avif" type="image/avif" />
    <img class={slow ? "spin-slow" : "spin"} src="/images/five-points-wellness-logo.webp" width={size} height={size} alt="" loading="lazy" decoding="async" />
  </picture>
</div>
