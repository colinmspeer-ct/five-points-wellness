---
// AcuBliss patient portal embed. The src is set only when the card is about to scroll into view,
// so the portal (and the cookie it sets) is not loaded for visitors who never reach it.
import { practice } from "../data/site";
interface Props { title: string; class?: string }
const { title, class: className } = Astro.props;
---
<div class:list={[className, "portal-frame"]} data-portal>
  <iframe data-src={practice.bookingUrl} title={title}></iframe>
  <noscript><p class="portal-noscript"><a href={practice.bookingUrl}>Open the patient portal to book online</a></p></noscript>
</div>

<script is:inline>
  (function () {
    var boxes = document.querySelectorAll("[data-portal]:not([data-portal-ready])");
    if (!boxes.length) return;
    function load(box) {
      var frame = box.querySelector("iframe[data-src]");
      if (!frame) return;
      frame.addEventListener("load", function () { box.classList.add("is-loaded"); }, { once: true });
      frame.src = frame.getAttribute("data-src");
      frame.removeAttribute("data-src");
    }
    boxes.forEach(function (box) { box.setAttribute("data-portal-ready", ""); });
    if (!("IntersectionObserver" in window)) { boxes.forEach(load); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        io.unobserve(entry.target);
        load(entry.target);
      });
    }, { rootMargin: "200px 0px" });
    boxes.forEach(function (box) { io.observe(box); });
  })();
</script>
