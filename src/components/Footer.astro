---
import Hours from "./Hours.astro";
import { areas } from "../data/areas";
import { practice } from "../data/site";

const year = 2026;
const cityAreas = areas.filter((area) => area.group === "philadelphia");
---

<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <p class="foot-brand">
          <img src="/images/five-points-wellness-logo-64.webp" width="34" height="34" alt="" loading="lazy" decoding="async" />
          Five Points Wellness, LLC
        </p>
        <address>
          {practice.street}<br />
          {practice.city}, {practice.region} {practice.postal}<br />
          {practice.areaNote}
        </address>
        <p>{practice.practitionerFull}<br />Licensed Acupuncturist</p>
        <p><a href={practice.mapLink}>Open in Google Maps</a></p>
      </div>

      <div>
        <h2>Quick Links</h2>
        <ul class="foot-links">
          <li><a href="/about">About Cara Speer</a></li>
          <li><a href="/services">Our Services</a></li>
          <li><a href="/acupuncture">Acupuncture</a></li>
          <li><a href="/dry-needling">Dry Needling</a></li>
          <li><a href="/microneedling">Microneedling</a></li>
          <li><a href="/book-appointment">Book an Appointment</a></li>
          <li><a href="/contact">Contact Us</a></li>
        </ul>
      </div>

      <div>
        <h2>Contact Information</h2>
        <p class="contact-line">Phone: <a href={`tel:${practice.phoneTel}`}>{practice.phoneDisplay}</a> <span aria-hidden="true">·</span> <a href={`sms:${practice.phoneTel}`}>Text</a></p>
        <p class="contact-line">Email: <a href={`mailto:${practice.email}`}>{practice.email}</a></p>
        <p class="foot-hours-label">Hours, by appointment only:</p>
        <Hours note={false} compact />
      </div>
    </div>

    <div class="foot-areas">
      <span class="label">Neighborhoods we serve:</span>
      <ul>
        {cityAreas.map((area) => (
          <li><a href={`/${area.slug}`}>{area.name}</a></li>
        ))}
        <li><a href="/locations">All areas</a></li>
      </ul>
    </div>

    <div class="legal">
      <p>&copy; {year} Five Points Wellness, LLC. All rights reserved.</p>
      <ul>
        <li><a href="/privacy-policy">Privacy Policy</a></li>
        <li><a href="/terms">Terms</a></li>
        <li><a href="/locations">Locations</a></li>
        <li><a href="/sitemap/">Sitemap</a></li>
      </ul>
      <p class="disclaimer">Acupuncture is complementary care and does not replace emergency or primary medical care.</p>
    </div>
  </div>
</footer>
