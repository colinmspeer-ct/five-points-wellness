---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import LocationLinks from "../components/LocationLinks.astro";
import { addressLine, practice } from "../data/site";

const title = "Areas served from Fishtown | Five Points Wellness";
const description =
  "One studio at 2137 E Huntingdon St, Philadelphia. Area pages for Philadelphia neighborhoods, the Main Line, and nearby towns whose residents travel to Fishtown.";
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Areas", href: "/locations" },
];
---

<Base title={title} description={description} crumbs={crumbs}>
  <PageHero
    eyebrow={`One studio · ${practice.street}`}
    lede={`We have one studio, at ${addressLine}. Patients come to us from neighborhoods across Philadelphia, the Main Line, and nearby towns. Call or text ${practice.phoneDisplay}.`}
  >Areas served from the <span class="accent">Fishtown studio</span></PageHero>
  <section class="band">
    <article class="narrow prose">
      <p>
        Our home neighborhood is <a href="/fishtown">Fishtown</a>, and the page for acupuncture there is <a href="/fishtown/acupuncture">acupuncture in Fishtown</a>. Each page below covers the trip from that area.
      </p>
      <LocationLinks showAll={false} />
      <p class="subhead">Bella Vista</p>
      <p>
        Our earlier Bella Vista pages are still here: <a href="/acupuncture-bella-vista">acupuncture in Bella Vista</a> and <a href="/dry-needling-bella-vista">dry needling in Bella Vista</a>.
      </p>
      <p class="subhead">Don't see your town?</p>
      <p>You can still book. Call or text {practice.phoneDisplay} and come to Huntingdon Street.</p>
      <CtaBand />
    </article>
  </section>
</Base>
