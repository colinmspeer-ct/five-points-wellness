---
import Base from "../layouts/Base.astro";
import Actions from "../components/Actions.astro";
import LocationLinks from "../components/LocationLinks.astro";
import { addressLine, practice } from "../data/site";

const title = "Areas served from Fishtown | Five Points Wellness";
const description =
  "One studio at 2137 E Huntingdon St, Philadelphia. Area pages for Philadelphia neighborhoods, the Main Line, and nearby towns whose residents travel to Fishtown.";
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Areas", href: "/locations" },
];
---

<Base title={title} description={description} crumbs={crumbs}>
  <article class="wrap content">
    <header class="page-hero">
      <p class="eyebrow">One studio · {addressLine}</p>
      <h1>Areas served from the Fishtown studio</h1>
      <p class="lede">
        {practice.name} has one treatment room, at {addressLine}, phone {practice.phoneDisplay}. Philadelphia pages describe that neighborhood. Main Line and nearby town pages are for residents who travel in. None of those towns has a second office.
      </p>
      <Actions />
    </header>
    <p>
      The Google Business Profile address is the Fishtown studio. The area hub for that neighborhood is <a href="/fishtown">Fishtown</a>, and the acupuncture page is <a href="/fishtown/acupuncture">acupuncture in Fishtown</a>.
    </p>
    <LocationLinks />
    <h2>Bella Vista</h2>
    <p>
      Bella Vista is not in the new area set. The earlier pages are still here: <a href="/acupuncture-bella-vista">acupuncture in Bella Vista</a> and <a href="/dry-needling-bella-vista">dry needling in Bella Vista</a>.
    </p>
    <h2>What these pages are not</h2>
    <p>
      They are not extra clinics. If your town is not listed, you can still book. Call or text {practice.phoneDisplay} and come to Huntingdon Street.
    </p>
  </article>
</Base>
