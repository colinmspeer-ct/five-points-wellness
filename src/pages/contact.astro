---
import { href } from "../lib/legacy";
import Base from "../layouts/Base.astro";
import Hours from "../components/Hours.astro";
import PageHero from "../components/PageHero.astro";
import YinYang from "../components/YinYang.astro";
import { practice } from "../data/site";

const title = "Contact Five Points Wellness in Fishtown | Acupuncture";
const description =
  "Contact Five Points Wellness LLC at 2137 E Huntingdon St, Philadelphia, PA 19125. Call or text (610) 742-5810 or email fivepointsphila@gmail.com.";
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Contact", href: "/contact" },
];
---

<Base title={title} description={description} crumbs={crumbs}>
  <div style="position:relative">
    <YinYang size={170} style="top:4rem;right:6%" />
    <PageHero eyebrow="Get in touch" lede="We are here to answer your questions.">
      Contact <span class="accent">Five Points Wellness</span>
    </PageHero>
  </div>

  <section class="band">
    <div class="mid" style="max-width:48rem">
      <h2 style="text-align:center;font-size:1.6rem;margin-bottom:2rem">Connect with Five Points Wellness</h2>
      <div class="contact-list">
        <div class="card contact-card">
          <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg></span>
          <div>
            <h3>Location</h3>
            <p>{practice.street}, {practice.city}, {practice.region} {practice.postal}</p>
            <p>Fishtown neighborhood, on the East Kensington edge</p>
            <p>Free street parking readily available</p>
            <p>Huntingdon Station on the Market-Frankford Line is about half a mile west, at Kensington Avenue and Huntingdon Street. Walk east to the 2100 block.</p>
            <div class="actions">
              <a class="btn btn-outline btn-sm" href={practice.mapLink}>Open in Google Maps</a>
              <a class="btn btn-outline btn-sm" href={href("/locations")}>Directions from your neighborhood</a>
            </div>
          </div>
        </div>

        <div class="card contact-card">
          <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z"/></svg></span>
          <div>
            <h3>Phone</h3>
            <p>{practice.phoneDisplay}</p>
            <p>Call or Text for Appointments or Questions</p>
            <div class="actions">
              <a class="btn btn-outline btn-sm" href={`tel:${practice.phoneTel}`}>Call Now</a>
              <a class="btn btn-outline btn-sm" href={`sms:${practice.phoneTel}`}>Send a Text</a>
            </div>
          </div>
        </div>

        <div class="card contact-card">
          <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg></span>
          <div>
            <h3>Email</h3>
            <p>{practice.email}</p>
            <p>We typically respond within one business day.</p>
            <div class="actions">
              <a class="btn btn-outline btn-sm" href={`mailto:${practice.email}`}>Send Email</a>
            </div>
          </div>
        </div>

        <div class="card contact-card">
          <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span>
          <div>
            <h3>Hours</h3>
            <p>By Appointment</p>
            <div style="max-width:20rem;margin-top:0.5rem"><Hours note={false} compact /></div>
            <div class="actions">
              <a class="btn btn-primary btn-sm" href={href("/book-appointment")}>Book Appointment</a>
            </div>
          </div>
        </div>
      </div>

      <p class="fine" style="text-align:center;margin-top:2.5rem">
        Insurance and a general acupuncture fee are not listed on this website, so please ask when you call if you need either before you book.
        Microneedling prices are on the <a href={href("/microneedling")}>microneedling</a> page.
      </p>
    </div>
  </section>
</Base>
