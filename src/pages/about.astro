---
import { href } from "../lib/legacy";
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import PageHero from "../components/PageHero.astro";
import Picture from "../components/Picture.astro";
import Testimonials from "../components/Testimonials.astro";
import YinYang from "../components/YinYang.astro";
import YinYangIcon from "../components/YinYangIcon.astro";
import { practice, training } from "../data/site";

const title = "About Cara Speer, L.Ac. | Five Points Wellness";
const description =
  "Cara Speer, M.Ac., L.Ac., is the licensed acupuncturist at Five Points Wellness LLC in Fishtown, Philadelphia. Read her training as the practice states it.";
const crumbs = [
  { name: "Home", href: "/" },
  { name: "About", href: "/about" },
];
---

<Base title={title} description={description} crumbs={crumbs}>
  <PageHero eyebrow="Licensed Acupuncturist · Fishtown, Philadelphia">
    About <span class="accent">Cara Speer, M.Ac., L.Ac.</span>
  </PageHero>

  <section class="band" style="position:relative;overflow:hidden">
    <YinYang size={200} style="top:3rem;right:3rem" />
    <div class="mid meet" style="position:relative;z-index:1">
      <div class="portrait-card">
        <Picture
          name="cara-speer-licensed-acupuncturist"
          width={640}
          height={640}
          loading="eager"
          alt="Close portrait of Cara Speer, licensed acupuncturist and owner of Five Points Wellness LLC in Philadelphia. Her blonde hair falls past her shoulders, and she wears a magenta top, a thin necklace, and a small rectangular pendant. Green foliage is visible behind the circular crop of the photo."
        />
      </div>
      <div>
        <h2>Meet <span class="accent">Cara</span></h2>
        <p>
          As a licensed acupuncturist, Cara is committed to serving her community with integrity and compassion, staying rooted in the wisdom of Traditional Chinese Medicine while continuously learning from her patients and adapting to their ever changing needs.
        </p>
        <p>
          Traditional Chinese Medicine (TCM), 5 Element Acupuncture, and Kiiko-style may be used depending on the patient.
        </p>
      </div>
    </div>

    <div class="narrow prose" style="margin-top:4rem;position:relative;z-index:1">
      <h2>Clinical Training &amp; Credentials</h2>
      <p>Treatment is provided by a licensed acupuncturist with advanced clinical training including:</p>
      <ul class="checklist">
        {training.map((item) => <li>{item}</li>)}
      </ul>
      <p>
        This training provides a comprehensive foundation in both traditional acupuncture theory and modern biomedical approaches to pain and movement dysfunction.
      </p>

      <h2>The Studio</h2>
      <p>
        Cara sees patients at <strong>{practice.name}</strong>, {practice.street}, {practice.city}, {practice.region} {practice.postal}, in the Fishtown / East Kensington neighborhood. Free street parking is readily available.
        Call or text <a href={`tel:${practice.phoneTel}`}>{practice.phoneDisplay}</a>, or email <a href={`mailto:${practice.email}`}>{practice.email}</a>.
      </p>
      <p>
        To learn how a visit works, read <a href={href("/acupuncture")}>acupuncture in Philadelphia</a>. For directions, see <a href={href("/acupuncture-fishtown")}>acupuncture in Fishtown</a>.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="patients-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="patients-heading" class="with-icon"><YinYangIcon size={40} /> <span>What Our <span class="accent">Patients Say</span></span></h2>
        <p>Hear from those who have experienced healing and wellness at Five Points Wellness</p>
      </div>
      <Testimonials />
      <div class="narrow">
        <CtaBand />
      </div>
    </div>
  </section>
</Base>
