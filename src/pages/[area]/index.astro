---
import { href } from "../../lib/legacy";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";
import FaqList from "../../components/FaqList.astro";
import Hours from "../../components/Hours.astro";
import { areas, areaBySlug } from "../../data/areas";
import { offeredServices } from "../../data/offeredServices";
import { addressLine, practice } from "../../data/site";

export function getStaticPaths() {
  return areas.map((area) => ({ params: { area: area.slug } }));
}

const slug = Astro.params.area ?? "";
const area = areaBySlug.get(slug);
if (!area) throw new Error(`Missing area ${slug}`);

const nearby = area.nearby.map((item) => areaBySlug.get(item)).filter((item) => item != null);
const title = area.atStudio
  ? `Acupuncture in ${area.h1Place} | Five Points Wellness`
  : `Acupuncture for ${area.h1Place} | Five Points Wellness`;
const description = area.atStudio
  ? `Acupuncture and the rest of Cara Speer’s services in ${area.h1Place}. Five Points Wellness LLC, ${addressLine}. ${practice.phoneDisplay}.`
  : `Acupuncture for ${area.name} residents who travel to Five Points Wellness in Fishtown. No office in ${area.name}. ${addressLine}. ${practice.phoneDisplay}.`;
const crumbs = [
  { name: "Home", href: "/" },
  { name: area.name, href: `/${area.slug}` },
];
const faqs = [
  {
    q: area.atStudio
      ? `Is the studio in ${area.name}?`
      : `Is there a Five Points office in ${area.name}?`,
    a: area.atStudio
      ? `Yes. The only studio is ${addressLine}, on the Fishtown and East Kensington edge.`
      : `No. ${area.name} residents are seen at ${addressLine}. ${area.distance}`,
  },
  {
    q: `How do people from ${area.name} get to the studio?`,
    a: `${area.transit} ${area.drive}`,
  },
  {
    q: "What is the phone number?",
    a: `Call or text ${practice.phoneDisplay}. Email ${practice.email}.`,
  },
];
const extraGraph = [
  {
    "@type": "FAQPage",
    mainEntity: faqs.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];
---

<Base title={title} description={description} crumbs={crumbs} extraGraph={extraGraph}>
  <PageHero
    eyebrow={area.atStudio ? `Five Points Wellness · ${practice.street}` : `Serving ${area.name}`}
    lede={area.atStudio
      ? `Our studio is right here, at ${addressLine}. Call or text ${practice.phoneDisplay}.`
      : `We don't have an office in ${area.name}. Patients from ${area.name} visit our Fishtown studio at ${addressLine}. Call or text ${practice.phoneDisplay}.`}
  >{area.atStudio ? `Acupuncture in ${area.h1Place}` : `Acupuncture for ${area.h1Place}`}</PageHero>
  <section class="band">
    <article class="narrow prose">
      <dl class="facts card" style="padding:1.25rem 1.5rem">
        <div><dt>Distance</dt><dd>{area.distance}</dd></div>
        <div><dt>ZIP codes</dt><dd>{area.zips} · studio 19125</dd></div>
      </dl>
      <h2>{area.name} and the Studio</h2>
      <p>{area.character}</p>
      <h3>Getting here</h3>
      <p>{area.commute}</p>
      <p>{area.drive}</p>
      <p>{area.transit}</p>
      <h3>Landmarks in {area.name}</h3>
      <ul class="checklist cols">
        {area.landmarks.map((item) => <li>{item}</li>)}
      </ul>
      <h2>Our Services for {area.name}</h2>
      <p>Every service below is offered at our Fishtown studio.</p>
      <ul class="chips">
        {offeredServices.map((service) => (
          <li><a href={href(`/${area.slug}/${service.slug}`)}>{service.h1Name} in {area.name}</a></li>
        ))}
      </ul>
      <h2>Hours</h2>
      <div class="card" style="padding:1.25rem 1.5rem;max-width:26rem"><Hours compact /></div>
      <FaqList items={faqs} heading={`Questions about coming from ${area.name}`} />
      <CtaBand />
      {nearby.length > 0 && (
        <>
          <p class="subhead">Nearby Areas</p>
          <ul class="chips">
            {nearby.map((item) => (
              <li><a href={href(`/${item.slug}`)}>{item.name}</a></li>
            ))}
            <li><a href={href("/locations")}>All areas</a></li>
          </ul>
        </>
      )}
    </article>
  </section>
</Base>
