---
import { href } from "../lib/legacy";
import Base from "../layouts/Base.astro";
import BookingPanel from "../components/BookingPanel.astro";
import Hours from "../components/Hours.astro";
import PageHero from "../components/PageHero.astro";
import { practice } from "../data/site";

const title = "Book Acupuncture in Philadelphia | Five Points Wellness";
const description =
  "Book acupuncture or microneedling at Five Points Wellness in Fishtown. Use the patient portal, or call or text (610) 742-5810. The calendar loads only when you open it.";
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Book", href: "/book-appointment" },
];
---

<Base title={title} description={description} crumbs={crumbs}>
  <PageHero
    eyebrow="Patient portal · phone · text"
    lede="Book online through our patient portal below, or text, call or email us directly."
  >Book an <span class="accent">Appointment</span></PageHero>

  <section class="band">
    <div class="mid" style="max-width:52rem">
      <BookingPanel
        heading="Book Online via Patient Portal"
        lead="Book your appointment online and manage your health information using our patient portal."
        small="Not sure yet? You can also use the portal to schedule a complimentary session to ask questions before you commit."
      />

      <div class="grid two" style="margin-top:2rem">
        <div class="card">
          <h2 style="font-size:1.25rem;font-weight:600">Schedule Your Session</h2>
          <p style="color:var(--muted)">Text, call or email us for availability and to book your appointment.</p>
          <div class="contact-list" style="gap:0.9rem">
            <p style="margin:0"><strong>Phone</strong><br /><a href={`tel:${practice.phoneTel}`}>{practice.phoneDisplay}</a> · <a href={`sms:${practice.phoneTel}`}>Text</a></p>
            <p style="margin:0"><strong>Email</strong><br /><a href={`mailto:${practice.email}`}>{practice.email}</a></p>
          </div>
        </div>
        <div class="card">
          <h2 style="font-size:1.25rem;font-weight:600">Hours</h2>
          <Hours />
        </div>
      </div>

      <h2 style="text-align:center;margin:4rem 0 0.5rem;font-size:1.6rem">Microneedling <span class="accent">Services</span></h2>
      <div class="price-grid">
        <div class="card price-card">
          <h3>Single Session</h3>
          <p>50 minutes</p>
          <p class="price">$350</p>
        </div>
        <div class="card price-card">
          <span class="tag">Save $200</span>
          <h3>4-Session Package</h3>
          <p>50 minutes each · 4 appointments</p>
          <p class="price">$1,200</p>
        </div>
      </div>
      <p class="fine" style="text-align:center;margin-top:1.25rem">
        You can also book microneedling through our online portal above, where you can choose between a single session or package.
        A general acupuncture price is not published here. The race-day package on the <a href={href("/acupuncture/sports-performance-recovery")}>sports page</a> is $325, booked by phone or text only.
      </p>
    </div>
  </section>
</Base>
