---
import { href } from "../lib/legacy";
import Base from "../layouts/Base.astro";
import Hours from "../components/Hours.astro";
import Picture from "../components/Picture.astro";
import Testimonials from "../components/Testimonials.astro";
import YinYang from "../components/YinYang.astro";
import YinYangIcon from "../components/YinYangIcon.astro";
import { areas } from "../data/areas";
import { conditionMeta, conditionOrder } from "../data/conditionMeta";
import { hours, practice } from "../data/site";

const mapEmbed = practice.mapEmbed;
const reviewsUrl =
  "https://www.google.com/maps/search/?api=1&query=Five+Points+Wellness+LLC+2137+E+Huntingdon+St+Philadelphia+PA+19125";

const title = "Acupuncture in Fishtown, Philadelphia | Five Points Wellness";
const description =
  "Licensed acupuncturist Cara Speer offers acupuncture and Chinese medicine at Five Points Wellness LLC, 2137 E Huntingdon St, Fishtown, Philadelphia. Call or text (610) 742-5810.";

// Plain-sentence hours for the answer paragraph, built from the same data as the hours table and schema.
const open = hours.filter((row) => row.opens);
const weekday = open.filter((row) => row.time === open[0].time);
const rest = open.slice(weekday.length);
const hoursSentence = [
  `${weekday[0].day} through ${weekday[weekday.length - 1].day} ${weekday[0].time}`,
  ...rest.map((row) => `${row.day} ${row.time}`),
]
  .join(", ")
  .replace(/, ([^,]*)$/, ", and $1");

const nearbyAreas = areas.filter((area) => area.group === "philadelphia").slice(0, 8);
---

<Base title={title} description={description}>
  <section class="home-hero">
    <div class="wrap">
      <p class="script">Five Points Wellness</p>
      <p class="local">Acupuncture in Fishtown, Philadelphia</p>
      <h1>
        Transform Your
        <span class="accent-word">Wellness</span>
        with Acupuncture
      </h1>
      <p class="lede">
        Rooted in traditional Chinese medicine, we are committed to your journey towards balance and well-being.
      </p>
      <div class="actions">
        <a class="btn btn-primary btn-lg" href={href("/book-appointment")}>Book an Appointment</a>
        <a class="btn btn-outline btn-lg" href={href("/acupuncture")}>Learn About Our Approach</a>
      </div>
      <p class="actions-note">
        Not sure yet? <a href={href("/book-appointment#portal")}>Schedule a complimentary session</a> to ask questions before you commit.
      </p>
      <div class="credentials">
        <p class="small">Licensed Acupuncturist</p>
        <p class="strong">Serving the Philadelphia Area</p>
      </div>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="meet-heading">
    <YinYang size={200} style="top:2.5rem;right:2.5rem" />
    <div class="mid meet">
      <div class="portrait-card">
        <Picture
          name="cara-speer-licensed-acupuncturist"
          width={640}
          height={640}
          alt="Portrait of Cara Speer, M.Ac., L.Ac., the licensed acupuncturist at Five Points Wellness in Philadelphia. She has long blonde hair and wears a magenta top and a small gold pendant, photographed outdoors with trees behind her. The portrait introduces her on the practice homepage."
        />
      </div>
      <div>
        <h2 id="meet-heading">Meet <span class="accent">Cara Speer, M.Ac., L.Ac.</span></h2>
        <p>
          As a licensed acupuncturist, Cara is committed to serving her community with integrity and compassion, staying rooted in the wisdom of Traditional Chinese Medicine while continuously learning from her patients and adapting to their ever changing needs.
        </p>
        <a class="text-link" href={href("/about")}>About Cara Speer <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section" id="testimonials" aria-labelledby="patients-heading" style="padding-top:2rem">
    <YinYang size={180} style="top:2.5rem;left:5%" slow />
    <YinYang size={120} style="bottom:5rem;right:9%" />
    <div class="wrap">
      <div class="section-head">
        <h2 id="patients-heading" class="with-icon"><YinYangIcon size={40} /> <span>What Our <span class="accent">Patients Say</span></span></h2>
        <p>Hear from those who have experienced healing and wellness at Five Points Wellness</p>
      </div>
      <Testimonials />
    </div>
  </section>

  <section class="section" aria-labelledby="help-heading" style="padding-top:1.5rem">
    <div class="mid" style="text-align:center">
      <h2 id="help-heading">Ways We Can <span class="accent">Help</span></h2>
      <p class="lede" style="font-size:1.0625rem">
        Acupuncture can address a wide range of health concerns, from acute conditions to chronic disorders.
      </p>
      <ul class="chips center" style="margin-top:1.75rem">
        {conditionOrder.map((slug) => (
          <li><a href={href(`/acupuncture/${slug}`)}>{conditionMeta[slug].label}</a></li>
        ))}
        <li><a href={href("/acupuncture/dry-needling")}>Dry Needling</a></li>
        <li><a href={href("/microneedling")}>Microneedling</a></li>
      </ul>
      <p style="margin-top:1.5rem"><a class="text-link" href={href("/services")}>See all of our services <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="section" id="find-us" aria-labelledby="visit-heading" style="padding-top:2rem">
    <div class="wrap visit">
      <div class="visit-copy">
        <h2 id="visit-heading">Visit the <span class="accent">Studio</span></h2>
        <p class="answer">
          Five Points Wellness is an acupuncture practice at {practice.street} in Fishtown, Philadelphia. Cara Speer, M.Ac., L.Ac., is the licensed acupuncturist. She sees patients by appointment {hoursSentence}. Call or text <a href={`tel:${practice.phoneTel}`}>{practice.phoneDisplay}</a> to book.
        </p>
        <p>
          We're on East Huntingdon Street, where Fishtown meets East Kensington. Huntingdon Station on the Market-Frankford Line is about a half-mile walk west, and free street parking is readily available.
        </p>
        <address>
          <strong>Five Points Wellness LLC</strong><br />
          {practice.street}, {practice.city}, {practice.region} {practice.postal}<br />
          <a href={`tel:${practice.phoneTel}`}>{practice.phoneDisplay}</a> · call or text
        </address>
        <div class="card" style="padding:1.25rem 1.5rem">
          <h3>Hours</h3>
          <Hours compact />
        </div>
        <p style="margin-top:1.5rem;margin-bottom:0.25rem">Coming from another neighborhood? We see patients from all over the city.</p>
        <ul class="chips">
          {nearbyAreas.map((area) => (
            <li><a href={href(`/${area.slug}`)}>{area.name}</a></li>
          ))}
          <li><a href={href("/locations")}>All areas</a></li>
        </ul>
      </div>
      <div>
        <div class="map-facade" data-map>
          <svg class="map-pin" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          <p class="map-name">Five Points Wellness LLC</p>
          <p class="map-addr">{practice.street}<br />{practice.city}, {practice.region} {practice.postal}</p>
          <p class="map-note">{practice.areaNote}</p>
          <div class="map-actions">
            <button type="button" class="btn btn-primary" data-show-map>Show map</button>
            <a class="btn btn-outline" href={practice.mapLink}>Open in Google Maps</a>
          </div>
        </div>
        <p style="margin-top:0.9rem;text-align:center"><a class="text-link" href={reviewsUrl}>Read our reviews on Google <span aria-hidden="true">→</span></a></p>
      </div>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ mapEmbed }}>
  (function () {
    var button = document.querySelector("[data-show-map]");
    if (!button) return;
    button.addEventListener("click", function () {
      var box = button.closest("[data-map]");
      var frame = document.createElement("iframe");
      frame.src = mapEmbed;
      frame.title = "Google Map of Five Points Wellness LLC, 2137 E Huntingdon St, Philadelphia, PA 19125";
      frame.referrerPolicy = "no-referrer-when-downgrade";
      box.classList.add("is-loaded");
      box.replaceChildren(frame);
      frame.focus();
    });
  })();
</script>
