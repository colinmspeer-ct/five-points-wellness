---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import FaqList from "../components/FaqList.astro";
import Picture from "../components/Picture.astro";
import { practice } from "../data/site";

const title = "Microneedling in Philadelphia | Five Points Wellness";
const description =
  "Microneedling in Fishtown, Philadelphia, at Five Points Wellness. Collagen induction with Cara Speer. $350 a session or $1,200 for four. Individual results vary.";
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Microneedling", href: "/microneedling" },
];
const concerns = [
  "Fine lines and wrinkles",
  "Loss of skin firmness and elasticity",
  "Acne scarring",
  "Hyperpigmentation and uneven skin tone",
  "Enlarged pores",
  "Sun damage and age spots",
  "Dull or uneven skin texture",
  "Stretch marks",
];
const areas = [
  "Face: full face rejuvenation, targeted zones",
  "Neck and décolletage",
  "Scalp: for hair thinning support",
  "Body: scars, stretch marks, and texture concerns",
];
const contraindications = [
  "High blood pressure",
  "Problems with bleeding or bruising",
  "Severe migraine headaches",
  "Parkinson's disease",
  "Recent microdermabrasion",
  "Diabetes mellitus",
  "Cancer",
  "AIDS",
  "Recent laser treatments",
  "Hepatitis",
  "Vertigo",
  "Hemophilia",
  "Botox treatments",
  "Dermal filler (Restylane, Juvederm, Radiesse, etc.)",
  "Any skin diseases (poison ivy, eczema, hives)",
  "Pregnancy",
  "Cold or flu",
  "Herpes outbreak",
  "Allergic reactions",
  "Extreme stress or tension",
];
const faqs = [
  { q: "Is microneedling painful?", a: "A topical numbing cream is applied before treatment to minimize discomfort. Most patients describe the sensation as mild pressure or warmth rather than pain." },
  { q: "How many sessions will I need?", a: "Most patients see optimal results with a series of 4–6 sessions. Maintenance treatments every 3–6 months help sustain results. The published package is four sessions." },
  { q: "Is there downtime?", a: "Redness and mild swelling typically resolve within 24–48 hours. Most patients return to normal activities the following day. Use mineral sunscreen for one week after treatment whenever there is sun exposure." },
  { q: "Can microneedling be combined with acupuncture?", a: "Yes. Combining acupuncture with microneedling is recommended for the internal factors that affect skin. Facial rejuvenation acupuncture and microneedling are not performed on the same day. If acupuncture is done the same day as microneedling, only body points are used." },
  { q: "Who is a good candidate?", a: "Microneedling is suitable for most skin types and tones. A consultation reviews skin goals, health history, and the contraindications listed on this page." },
];
const extraGraph = [
  {
    "@type": "Service",
    name: "Microneedling",
    serviceType: "Microneedling",
    url: `${practice.url}/microneedling`,
    provider: { "@id": `${practice.url}/#practice` },
    areaServed: { "@type": "City", name: "Philadelphia" },
    offers: [
      { "@type": "Offer", name: "Single microneedling session", price: "350", priceCurrency: "USD", description: "50 minutes" },
      { "@type": "Offer", name: "4-session microneedling package", price: "1200", priceCurrency: "USD", description: "50 minutes each, four appointments" },
    ],
  },
  {
    "@type": "FAQPage",
    mainEntity: faqs.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];
---

<Base title={title} description={description} crumbs={crumbs} extraGraph={extraGraph}>
  <PageHero eyebrow="Aesthetic & Wellness" lede="Collagen Induction Therapy for Skin Health & Rejuvenation">Microneedling in Philadelphia</PageHero>

  <section class="band">
    <div class="wrap" style="max-width:60rem">
      <h2 style="text-align:center;font-size:1.6rem;margin-bottom:1.5rem">Real <span class="accent">Results</span></h2>
      <div class="results">
        <figure>
          <Picture
            name="microneedling-before-after-front-view"
            width={960}
            height={640}
            loading="eager"
            alt="Front-view microneedling comparison from Five Points Wellness. Two portraits of the same woman sit side by side, labeled Before and After 3 treatments. The before photo shows more visible lines and uneven tone; the after photo shows her with the hair lighter and the skin looking smoother. Individual results vary."
          />
          <figcaption>Front view · before and after 3 treatments</figcaption>
        </figure>
        <figure>
          <Picture
            name="microneedling-before-after-side-view"
            width={960}
            height={640}
            loading="eager"
            alt="Side-view microneedling comparison from Five Points Wellness, labeled Before and After 3 treatments. The before profile shows cheek and jaw lines more clearly; the after profile shows the same woman turned slightly toward the camera with smoother-looking skin. Individual results vary, and lighting differs between the two photos."
          />
          <figcaption>Side view · before and after 3 treatments</figcaption>
        </figure>
      </div>
      <p class="fine" style="text-align:center;margin-top:1rem">Individual results may vary.</p>
    </div>

    <article class="narrow prose" style="margin-top:3.5rem">
      <p>
        Microneedling, also known as collagen induction therapy, is a minimally invasive skin treatment that uses fine needles to create controlled micro-channels in the skin's surface. This process stimulates the body's natural healing response, promoting the production of collagen and elastin for smoother, firmer, and more even-toned skin.
      </p>
      <p>
        At Five Points Wellness, microneedling is performed with an integrative perspective, addressing both the surface of the skin and the underlying health patterns that influence skin quality, healing capacity, and overall radiance.
      </p>

      <h2>How Microneedling Works</h2>
      <p>A specialized device with ultra-fine sterile needles creates thousands of microscopic punctures across the treatment area. These micro-injuries trigger the skin's natural wound-healing cascade, stimulating:</p>
      <ul class="checklist">
        <li>New collagen and elastin production</li>
        <li>Increased cellular turnover and skin renewal</li>
        <li>Enhanced absorption of topical serums and nutrients</li>
        <li>Improved circulation to the skin</li>
        <li>Gradual remodeling of scar tissue and texture irregularities</li>
      </ul>

      <h2>Conditions We Commonly Treat</h2>
      <ul class="checklist cols">
        {concerns.map((item) => <li>{item}</li>)}
      </ul>

      <h2>Treatment Areas</h2>
      <p>Microneedling can be applied to a variety of areas depending on your goals:</p>
      <ul class="checklist">
        {areas.map((item) => <li>{item}</li>)}
      </ul>

      <h2>An Integrative Approach to Skin Health</h2>
      <p>
        Skin health is closely connected to internal health. Hormonal balance, stress levels, circulation, sleep quality, and nutritional status all influence how the skin looks, feels, and heals. At Five Points Wellness, microneedling treatments can be paired with acupuncture to support the whole-body factors that contribute to skin quality.
      </p>
      <ul class="checklist">
        <li>Acupuncture to support circulation and nervous system regulation</li>
        <li>Hormonal balance support for acne-prone or aging skin</li>
        <li>Stress reduction to minimize inflammation and cortisol-related skin concerns</li>
        <li>Whole-body care that extends the results of surface treatment</li>
      </ul>

      <h2>What to Expect During Treatment</h2>
      <p>
        A topical numbing cream is applied prior to treatment to ensure your comfort. The microneedling device is then gently moved across the treatment area. Sessions typically last 30–60 minutes depending on the area being treated.
      </p>
      <p>After treatment, you may experience:</p>
      <ul class="checklist">
        <li>Mild redness and warmth, similar to a light sunburn</li>
        <li>Minor swelling that typically resolves within 24–48 hours</li>
        <li>Skin feeling tighter or smoother within days</li>
        <li>Progressive improvement in texture and tone over several weeks</li>
      </ul>

      <h2>What Results Can I Expect?</h2>
      <p>Because microneedling works by stimulating the skin's natural repair process, results develop gradually over time. Most patients notice:</p>
      <ul class="checklist">
        <li>Improved skin texture and smoothness after the first session</li>
        <li>Continued collagen remodeling over 4–6 weeks post-treatment</li>
        <li>Best results with a series of 4–6 sessions spaced 4–6 weeks apart</li>
        <li>Long-lasting improvements up to 5 years with periodic maintenance treatments</li>
      </ul>

      <h2>Pricing</h2>
      <div class="price-grid">
        <div class="card price-card">
          <h3>Single Session</h3>
          <p>50 minutes</p>
          <p class="price">$350</p>
        </div>
        <div class="card price-card">
          <span class="tag">Save $200</span>
          <h3>4-Session Package</h3>
          <p>50 minutes each · 4 appointments</p>
          <p class="price">$1,200</p>
        </div>
      </div>

      <FaqList items={faqs} />

      <CtaBand text="Book your appointment online to begin. If you'd like to talk through your skin goals before committing, you're welcome to schedule a complimentary session first." />
    </article>

    <div class="mid" style="max-width:52rem;margin-top:5rem">
      <div class="section-head" style="margin-bottom:1.75rem">
        <h2>Contraindications for <span class="accent">Treatment</span></h2>
        <p>Microneedling is not appropriate for everyone. Please review the following before booking.</p>
      </div>
      <div class="card">
        <ul class="dots cols" style="margin:0">
          {contraindications.map((item) => <li>{item}</li>)}
        </ul>
        <p class="fine" style="margin:1.25rem 0 0">If you have any of the above conditions, please contact us before scheduling so we can advise on the most appropriate treatment for you.</p>
      </div>
      <p class="fine" style="text-align:center;margin-top:2rem">
        Looking for something gentler? See <a href="/acupuncture/facial-rejuvenation-cosmetic">facial rejuvenation and cosmetic acupuncture</a> or <a href="/facial-cupping">facial cupping</a>.
      </p>
    </div>
  </section>
</Base>
