---
import Base from "../layouts/Base.astro";
import { addressLine, practice } from "../data/site";

const title = "Privacy Policy | Five Points Wellness LLC";
const description =
  "Privacy policy for Five Points Wellness LLC in Philadelphia: what the website and lead forms collect, how it is used, and how to ask for a change or deletion.";
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Privacy", href: "/privacy-policy" },
];
---

<Base title={title} description={description} crumbs={crumbs}>
  <article class="wrap content">
    <header class="page-hero">
      <h1>Privacy policy</h1>
      <p class="fine">Originally dated March 2025. Office address updated November 2026 to 2137 E Huntingdon St.</p>
    </header>
    <h2>Overview</h2>
    <p>
      Five Points Wellness LLC ("we," "us," or "our") is committed to protecting your privacy. This privacy policy describes how we collect, use, and safeguard personal information when you visit our website, submit a contact or inquiry form, or interact with our advertisements, including lead forms on Facebook and Instagram.
    </p>
    <h2>Information we collect</h2>
    <p>We may collect the following types of personal information:</p>
    <ul class="checklist">
      <li><strong>Contact information.</strong> Name, phone number, and email address submitted through our website or Facebook Lead Ads forms.</li>
      <li><strong>Inquiry details.</strong> Information you provide about your health interests or the services you are seeking.</li>
      <li><strong>Usage data.</strong> Browser type, pages visited, and general location data collected automatically when you visit our website.</li>
    </ul>
    <p>
      We do not collect protected health information (PHI) through this website or through Facebook Lead Ads. Clinical health records are managed separately within our HIPAA-compliant patient portal.
    </p>
    <h2>How we use your information</h2>
    <p>Information collected through this website and our lead forms is used solely to:</p>
    <ul class="checklist">
      <li>Respond to inquiries and schedule appointments.</li>
      <li>Provide information about our services.</li>
      <li>Send appointment reminders or follow-up communications, where applicable.</li>
    </ul>
    <p>We do not sell, rent, or share your personal information with third parties for marketing purposes.</p>
    <h2>Facebook Lead Ads</h2>
    <p>
      We may run lead generation advertisements on Facebook and Instagram. When you submit information through one of these forms, that information is transmitted to us via Meta's lead ads platform and is subject to both this privacy policy and Meta's Data Policy. We use the submitted information only to follow up on your inquiry and will not use it for any unrelated purpose. You may review Meta's Data Policy at <a href="https://www.facebook.com/privacy/policy">facebook.com/privacy/policy</a>.
    </p>
    <h2>Cookies and analytics</h2>
    <p>
      Our website may use cookies or similar tracking technologies to understand how visitors interact with the site. This data is aggregated and anonymous. You may disable cookies in your browser settings. Doing so will not affect your ability to access the information on this site.
    </p>
    <p>This rebuilt site does not load a third-party analytics script or the unused HighLevel form script from the previous site.</p>
    <h2>Data retention</h2>
    <p>
      We retain contact information submitted through inquiry forms and lead ads only as long as necessary to fulfill the purpose for which it was collected, or as required by applicable law. You may request deletion of your information at any time by contacting us directly.
    </p>
    <h2>Your rights</h2>
    <p>You have the right to:</p>
    <ul class="checklist">
      <li>Access the personal information we hold about you.</li>
      <li>Request correction of inaccurate information.</li>
      <li>Request deletion of your personal information.</li>
      <li>Opt out of future communications at any time.</li>
    </ul>
    <p>To exercise any of these rights, contact us using the information below.</p>
    <h2>Children's privacy</h2>
    <p>
      This website is not directed to individuals under the age of 13, and we do not knowingly collect personal information from children. If you believe a child has submitted information to us, contact us and we will promptly delete it.
    </p>
    <h2>Changes to this policy</h2>
    <p>
      We may update this privacy policy periodically. Changes will be posted on this page with a revised effective date. Continued use of our website following any update constitutes your acceptance of the revised policy.
    </p>
    <h2>Contact us</h2>
    <p>
      <strong>{practice.name}</strong><br />
      {addressLine}<br />
      Phone: <a href={`tel:${practice.phoneTel}`}>{practice.phoneDisplay}</a><br />
      Email: <a href={`mailto:${practice.email}`}>{practice.email}</a>
    </p>
  </article>
</Base>
