---
import { absUrl, href } from "../../lib/legacy";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";
import ServiceLinks from "../../components/ServiceLinks.astro";
import { conditionsTreated, practice, visitSteps } from "../../data/site";

const title = "Acupuncture in Philadelphia | Five Points Wellness LLC";
const description =
  "Acupuncture in Philadelphia with Cara Speer, M.Ac., L.Ac. Traditional Chinese medicine at Five Points Wellness, 2137 E Huntingdon St in Fishtown. Sessions are 50 minutes.";
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Acupuncture", href: "/acupuncture" },
];
const extraGraph = [
  {
    "@type": "Service",
    name: "Acupuncture",
    serviceType: "Acupuncture",
    url: absUrl("/acupuncture"),
    provider: { "@id": `${practice.url}/#practice` },
    areaServed: { "@type": "City", name: "Philadelphia" },
    description:
      "Needle therapy along the meridian system. Traditional Chinese Medicine, 5 Element acupuncture, and Kiiko-style may be used. Sessions are 50 minutes.",
  },
];
---

<Base title={title} description={description} crumbs={crumbs} extraGraph={extraGraph}>
  <PageHero
    eyebrow="Understanding acupuncture"
    lede="Acupuncture is an ancient healing practice rooted in Traditional Chinese Medicine that promotes natural healing and improved functioning of the body's systems."
  >Acupuncture in <span class="accent">Philadelphia</span></PageHero>

  <section class="band">
    <div class="mid" style="max-width:50rem">
      <div class="card prose" style="padding:2rem 2.25rem">
        <p>
          Acupuncture therapy involves the gentle insertion of very thin, sterile needles into specific points on the body to stimulate the flow of qi (pronounced "chee"), your body's vital energy. By restoring balance to your energy pathways, acupuncture helps activate your body's natural healing abilities.
        </p>
        <p>
          Modern research has shown that acupuncture triggers the release of endorphins, improves circulation and helps regulate the nervous system, making it an effective complement to modern medical intervention.
        </p>
        <p>
          A session is <strong>50 minutes</strong>. Traditional Chinese Medicine (TCM), 5 Element Acupuncture, and Kiiko-style may be used depending on the patient.
        </p>
      </div>

      <div style="text-align:center;margin-top:4.5rem">
        <h2>Benefits of <span class="accent">Acupuncture</span></h2>
      </div>
      <div class="card" style="max-width:26rem;margin:1.75rem auto 0">
        <ul class="dots" style="font-size:1rem;margin:0;gap:0.7rem">
          <li>Pain Relief</li>
          <li>Stress Reduction</li>
          <li>Improved Energy</li>
          <li>Holistic Wellness</li>
        </ul>
      </div>

      <div class="section-head" style="margin:4.5rem 0 1.75rem">
        <h2>Conditions We <span class="accent">Treat and Manage</span></h2>
        <p>Acupuncture can effectively address a wide range of health concerns, from acute conditions to chronic disorders.</p>
      </div>
      <div class="card">
        <ul class="checklist cols" style="margin:0">
          {conditionsTreated.map((item) => (
            <li><a href={href(item.href)}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="section-head" style="margin:4.5rem 0 1.75rem">
        <h2>What to <span class="accent">Expect</span></h2>
        <p>Your visit is built around your own symptoms, lifestyle, and goals.</p>
      </div>
      <ol class="steps">
        {visitSteps.map((step) => (
          <li class="card">
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>

      <div style="text-align:center;margin-top:4.5rem">
        <h2>Techniques That <span class="accent">May Be Added</span></h2>
        <p class="lede" style="font-size:1.0625rem">
          Moxibustion, gua sha, cupping, facial cupping, herbal liniments, tuina, nutrition guidance, and qigong are included in an acupuncture session at the practitioner's discretion.
        </p>
        <ServiceLinks except="/acupuncture" center />
      </div>

      <div class="narrow" style="width:100%">
        <CtaBand
          heading="Ready to Begin?"
          text="Schedule your appointment online and take the first step toward feeling your best."
        />
        <p class="actions-note"><a href={href("/acupuncture-fishtown")}>Acupuncture in Fishtown</a> · <a href={href("/locations")}>Neighborhoods we serve</a></p>
      </div>
    </div>
  </section>
</Base>
