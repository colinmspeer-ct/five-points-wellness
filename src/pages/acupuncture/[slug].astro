---
import { absUrl, href } from "../../lib/legacy";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";
import FaqList from "../../components/FaqList.astro";
import { conditionMeta, conditionOrder } from "../../data/conditionMeta";
import conditions from "../../data/conditions.json";
import { practice } from "../../data/site";

type Block = { title: string; description?: string; paragraphs?: string[]; items?: string[] };
type Condition = {
  title: string;
  tagline: string;
  overview: string[];
  introSections?: Block[];
  addresses: string[];
  sections?: Block[];
  howItHelps: string;
  whatToExpect: string;
  faqs?: { q: string; a: string }[];
};

export function getStaticPaths() {
  return conditionOrder.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug ?? "";
const page = (conditions as Record<string, Condition>)[slug];
const meta = conditionMeta[slug];
if (!page || !meta) throw new Error(`Missing condition ${slug}`);

const url = absUrl(`/acupuncture/${slug}`);
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Acupuncture", href: "/acupuncture" },
  { name: meta.label, href: `/acupuncture/${slug}` },
];
const extraGraph = [
  {
    "@type": "Service",
    name: meta.h1,
    serviceType: "Acupuncture",
    url,
    provider: { "@id": `${practice.url}/#practice` },
    areaServed: { "@type": "City", name: "Philadelphia" },
    description: meta.description,
  },
  ...(page.faqs?.length
    ? [{
        "@type": "FAQPage",
        mainEntity: page.faqs.map((item) => ({
          "@type": "Question",
          name: item.q,
          acceptedAnswer: { "@type": "Answer", text: item.a },
        })),
      }]
    : []),
];
---

<Base title={meta.title} description={meta.description} crumbs={crumbs} extraGraph={extraGraph}>
  <PageHero eyebrow="Acupuncture" lede={page.tagline}>{meta.h1}</PageHero>
  <section class="band">
    <article class="narrow prose">
      {page.overview.map((paragraph) => <p>{paragraph}</p>)}
      {page.introSections?.map((section) => (
        <section>
          <h2>{section.title}</h2>
          {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          {section.description && <p>{section.description}</p>}
          {section.items && (
            <ul class="checklist cols">{section.items.map((item) => <li>{item}</li>)}</ul>
          )}
        </section>
      ))}
      <h2>Conditions We Commonly Treat</h2>
      <ul class="checklist cols">
        {page.addresses.map((item) => <li>{item}</li>)}
      </ul>
      {page.sections?.map((section) => (
        <section>
          <h2>{section.title}</h2>
          {section.description && <p>{section.description}</p>}
          {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          {section.items && (
            <ul class="checklist cols">{section.items.map((item) => <li>{item}</li>)}</ul>
          )}
        </section>
      ))}
      <h2>How Acupuncture Helps</h2>
      <p>{page.howItHelps}</p>
      <h2>What to Expect</h2>
      <p>{page.whatToExpect}</p>
      {page.faqs && <FaqList items={page.faqs} />}
      <CtaBand />
      <p class="subhead">Other Conditions We Treat</p>
      <ul class="chips">
        {conditionOrder.filter((item) => item !== slug).map((item) => (
          <li><a href={href(`/acupuncture/${item}`)}>{conditionMeta[item].label}</a></li>
        ))}
        <li><a href={href("/acupuncture/dry-needling")}>Dry Needling</a></li>
        <li><a href={href("/acupuncture")}>Acupuncture in Philadelphia</a></li>
        <li><a href={href("/acupuncture-fishtown")}>Acupuncture in Fishtown</a></li>
      </ul>
    </article>
  </section>
</Base>
