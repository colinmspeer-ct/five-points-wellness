---
import LocationView from "../components/LocationView.astro";
import ModalityView from "../components/ModalityView.astro";
import { locations } from "../data/locations";
import { modalities } from "../data/modalities";

export function getStaticPaths() {
  return [
    ...locations.map((page) => ({ params: { slug: page.slug }, props: { kind: "location" as const } })),
    ...modalities.map((page) => ({ params: { slug: page.slug }, props: { kind: "modality" as const } })),
  ];
}

const { kind } = Astro.props;
const slug = Astro.params.slug ?? "";
---

{kind === "location" ? <LocationView slug={slug} /> : <ModalityView slug={slug} />}
